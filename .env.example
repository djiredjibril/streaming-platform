# PostgreSQL
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming
DATABASE_URL=postgresql://streaming:streaming@localhost:5432/streaming

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_ENDPOINT=http://localhost:9001

# Identity
# Used to sign/verify JWT access tokens (HS256). Generate a real random
# value for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
IDENTITY_GRPC_ADDRESS=0.0.0.0:50051

# Gateway
GATEWAY_HTTP_PORT=3000

# Catalog
# Own database on the shared local Postgres instance — see
# docker/postgres-init/01-create-catalog-db.sql.
CATALOG_DATABASE_URL=postgresql://streaming:streaming@localhost:5432/catalog
CATALOG_GRPC_ADDRESS=0.0.0.0:50052
