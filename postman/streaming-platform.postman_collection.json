{
  "info": {
    "name": "Streaming Platform",
    "description": "Manual test collection for the Gateway's /auth/* REST surface (docs/01-identity.md). Run the \"Identity — full session flow\" folder top to bottom: each request feeds the next via collection variables set in its Tests script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "testEmail", "value": "postman-test@example.com", "type": "string" },
    { "key": "testPassword", "value": "correct-horse-battery", "type": "string" },
    { "key": "verificationToken", "value": "", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Identity — full session flow",
      "description": "Run in order. Postman's cookie jar carries the httpOnly refresh_token cookie automatically between requests to the same baseUrl — nothing to copy by hand for it.",
      "item": [
        {
          "name": "1. Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"accountType\": \"PERSO\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Creates a PENDING_VERIFICATION account. Response includes emailVerificationToken — a V1 mock standing in for a real verification email (see proto/identity.proto's VerifyEmail comment)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 409 (already registered)', () => {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.account.status).to.eql('PENDING_VERIFICATION');",
                  "  pm.collectionVariables.set('verificationToken', body.emailVerificationToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["auth", "verify-email"] },
            "description": "Exchanges the mocked verification token from Register for account activation. Returns 400 if run twice (token already used) — that's expected if you re-run the flow without re-registering with a fresh email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (or 400 if already verified)', () => {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.expect(pm.response.json().account.status).to.eql('ACTIVE');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Requires the account to be ACTIVE (step 2 done). Sets the refresh_token httpOnly cookie automatically (Postman's cookie jar) and returns an accessToken in the body — never a refreshToken (see apps/web/AGENT.md)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('body has no refreshToken field', () => pm.expect(body).to.not.have.property('refreshToken'));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Validates the access token (IdentityService.ValidateToken) then fetches the account (GetAccount)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('email matches', () => {",
                  "  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Create profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Postman\",\n  \"isKidsProfile\": false\n}" },
            "url": { "raw": "{{baseUrl}}/auth/profiles", "host": ["{{baseUrl}}"], "path": ["auth", "profiles"] },
            "description": "accountId always comes from the Bearer token, never from the body (IDOR protection — see services/gateway/README.md). The account used in this flow is PERSO, capped at one profile: re-running this request a second time should return 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (or 403 if a profile already exists on this PERSO account)', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. List profiles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profiles", "host": ["{{baseUrl}}"], "path": ["auth", "profiles"] },
            "description": "Lists profiles for the Bearer-token-derived account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('at least one profile', () => pm.expect(pm.response.json().length).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Refresh",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Reads the refresh_token cookie set by Login, rotates it (old one is revoked — see docs/01-identity.md, refresh token rotation), and returns a fresh accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Revokes the current refresh_token cookie. Re-running \"5. Refresh\" after this should return 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
