// Identity domain model — see /docs/01-identity.md for the ER diagram and
// rationale (Account/Profile split, why Role is a join table, etc).
generator client {
  provider = "prisma-client-js"
  // Without this, `prisma generate` writes to the single hoisted
  // node_modules/.prisma/client shared by the whole npm workspace — the
  // last service to run `generate` silently overwrites every other
  // service's client (discovered when generating Catalog's client broke
  // Identity's tests: `this.prisma.account` no longer existed). A
  // service-local output directory is resolved first by Node for imports
  // from within this service (node_modules lookup walks up from the
  // importing file), so `import { PrismaClient } from '@prisma/client'` in
  // this service's own code keeps working unchanged.
  output = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  PERSO
  FAMILLE
  ETUDIANT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum StudentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RoleName {
  OWNER
  MEMBER
  KID
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_RESET
  TOKEN_REVOKED
}

model Account {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?       @map("password_hash")
  accountType  AccountType   @map("account_type")
  status       AccountStatus @default(PENDING_VERIFICATION)
  // Minimal admin role (see docs/01-identity.md, "État d'avancement"): no self-service
  // path sets this to true — only a direct DB write, documented in README.md, until a
  // real admin-management feature exists. Embedded in the JWT at Login/RefreshToken
  // (see domain/tokens.ts) so ValidateToken stays a pure signature check with no extra
  // DB lookup on the system's most frequently called RPC.
  isAdmin      Boolean       @default(false) @map("is_admin")
  // V1 mock email verification (see /proto/identity.proto, VerifyEmail):
  // hash of the token returned directly by Register instead of emailed.
  emailVerificationTokenHash String?   @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  studentVerification StudentVerification?
  profiles             Profile[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]

  @@map("accounts")
}

model StudentVerification {
  id               String                     @id @default(uuid())
  accountId        String                     @unique @map("account_id")
  universityEmail  String?                    @map("university_email")
  verificationStatus StudentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt       DateTime?                  @map("verified_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("student_verifications")
}

model Profile {
  id             String   @id @default(uuid())
  accountId      String   @map("account_id")
  displayName    String   @map("display_name")
  avatarUrl      String?  @map("avatar_url")
  isKidsProfile  Boolean  @default(false) @map("is_kids_profile")
  createdAt      DateTime @default(now()) @map("created_at")

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profileRoles ProfileRole[]

  @@map("profiles")
}

model Role {
  id           Int           @id @default(autoincrement())
  name         RoleName      @unique
  profileRoles ProfileRole[]

  @@map("roles")
}

model ProfileRole {
  profileId String @map("profile_id")
  roleId    Int    @map("role_id")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([profileId, roleId])
  @@map("profile_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id        String         @id @default(uuid())
  accountId String?        @map("account_id")
  eventType AuditEventType @map("event_type")
  ipAddress String         @map("ip_address")
  createdAt DateTime       @default(now()) @map("created_at")

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
