{
  "name": "@streaming/identity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -b",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test": "vitest run",
    "proto:gen": "protoc --plugin=protoc-gen-ts_proto=../../node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/grpc/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,env=node -I ../../proto ../../proto/identity.proto",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.12.2",
    "@prisma/client": "^5.22.0",
    "@streaming/shared-logging": "*",
    "argon2": "^0.41.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@testcontainers/redis": "^10.13.2",
    "dotenv-cli": "^7.4.4",
    "pino": "^9.5.0",
    "prisma": "^5.22.0",
    "ts-proto": "^2.2.7"
  }
}
